{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug minishell",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/minishell",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            // "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "environment": [],
            "console": "integratedTerminal",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                // {
                //     "description": "Follow parent after fork",
                //     "text": "-gdb-set follow-fork-mode parent"
                // },
                // {
                //     "description": "Follow child after fork",
                //     "text": "-gdb-set follow-fork-mode child"
                // },
                // {
                //     "description": "Allow switching between parent and child",
                //     "text": "-gdb-set detach-on-fork off"
                // },
                // {
                //     "description": "Do not detach from parent after fork",
                //     "text": "-gdb-set detach-on-fork off"
                // }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "trace": true,
                "traceResponse": true,
                "engineLogging": true 
            }
        }
    ]
}

